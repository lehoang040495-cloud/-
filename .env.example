# LLM Provider: deepseek / doubao
LLM_PROVIDER=doubao

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Doubao Proxy Configuration
DOUBAO_ENDPOINT=https://fosp-gateway.vemic.com/ai_proxy/v2/volces/chat/completions
DOUBAO_MODEL=doubao-seed-2-0-pro-260215
DOUBAO_OPEN_ID=your_open_id_here
DOUBAO_DEVELOPER_SECRET=your_secret_here

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/scenic_guide.db

# Server
HOST=0.0.0.0
PORT=8000

# RAG Configuration (use local model path to avoid downloading)
EMBEDDING_MODEL=./data/embedding_model
VECTOR_STORE_PATH=./data/vectors
KNOWLEDGE_PATH=./data/knowledge
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Weather
WEATHER_LATITUDE=30.57
WEATHER_LONGITUDE=104.07
WEATHER_LOCATION_NAME=景区

# TTS Configuration
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%

# STT Configuration
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
